{
  "name": "garden-rules-lab",
  "version": "0.1.0",
  "description": "Neutral Phaser test bench for hex-board rules and solvable level generation",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test",
    "inspect": "node --import tsx scripts/inspect-database.mjs",
    "generate": "node --import tsx scripts/generate-database.mjs",
    "verify": "node --import tsx scripts/verify-database.mjs",
    "check:campaign": "node --import tsx scripts/check-campaign.mjs",
    "context": "node scripts/chatgpt-context.mjs",
    "context:last": "node scripts/chatgpt-context.mjs --last-commit",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.1.3"
  },
  "license": "UNLICENSED",
  "private": true
}
